#include <ProgressBar>

new StaminaBar[MAX_PLAYERS] = {INVALID_PLAYER_BAR_ID, ...};
new HydrationBar[MAX_PLAYERS] = {INVALID_PLAYER_BAR_ID, ...};
new SpeedoRing[MAX_PLAYERS] = {INVALID_PLAYER_BAR_ID, ...};
new BoostGauge[MAX_PLAYERS] = {INVALID_PLAYER_BAR_ID, ...};

stock CreateStarterHUDShowcaseBars(playerid)
{
	StaminaBar[playerid] = CreatePlayerProgressBar(playerid, 497.00, 104.00, 54.00, 7.50, 0x10B981FF, 100.00, PB_DIR_RIGHT, 1.00, 0x0F172AE6, PB_STYLE_BAR, 24, 1.00);
	SetPlayerProgressBarValue(playerid, StaminaBar[playerid], 82.00);
	ShowPlayerProgressBar(playerid, StaminaBar[playerid]);

	HydrationBar[playerid] = CreatePlayerProgressBar(playerid, 554.00, 104.00, 54.00, 7.50, 0x38BDF8FF, 100.00, PB_DIR_RIGHT, 1.00, 0x0F172AE6, PB_STYLE_BAR, 24, 1.00);
	SetPlayerProgressBarValue(playerid, HydrationBar[playerid], 65.00);
	ShowPlayerProgressBar(playerid, HydrationBar[playerid]);

	SpeedoRing[playerid] = CreatePlayerProgressBar(playerid, 532.00, 312.00, 68.00, 85.00, 0xF59E0BFF, 240.00, PB_DIR_RIGHT, 0.80, 0x0F172AE6, PB_STYLE_RING, 24, 1.00);
	SetPlayerProgressBarValue(playerid, SpeedoRing[playerid], 155.00);
	ShowPlayerProgressBar(playerid, SpeedoRing[playerid]);

	BoostGauge[playerid] = CreatePlayerProgressBar(playerid, 552.00, 337.00, 28.00, 35.00, 0x3B82F6FF, 100.00, PB_DIR_RIGHT, 1.00, 0x0F172AE6, PB_STYLE_CIRCLE, 24, 1.00);
	SetPlayerProgressBarValue(playerid, BoostGauge[playerid], 60.00);
	ShowPlayerProgressBar(playerid, BoostGauge[playerid]);
	AutoFillPlayerProgressBar(playerid, BoostGauge[playerid], 100.00);
	return 1;
}

stock ShowStarterHUDShowcaseBars(playerid)
{
	ShowPlayerProgressBar(playerid, StaminaBar[playerid]);
	ShowPlayerProgressBar(playerid, HydrationBar[playerid]);
	ShowPlayerProgressBar(playerid, SpeedoRing[playerid]);
	ShowPlayerProgressBar(playerid, BoostGauge[playerid]);
	return 1;
}

stock HideStarterHUDShowcaseBars(playerid)
{
	HidePlayerProgressBar(playerid, StaminaBar[playerid]);
	HidePlayerProgressBar(playerid, HydrationBar[playerid]);
	HidePlayerProgressBar(playerid, SpeedoRing[playerid]);
	HidePlayerProgressBar(playerid, BoostGauge[playerid]);
	return 1;
}

stock DestroyStarterHUDShowcaseBars(playerid)
{
	DestroyPlayerProgressBar(playerid, StaminaBar[playerid]);
	StaminaBar[playerid] = INVALID_PLAYER_BAR_ID;
	DestroyPlayerProgressBar(playerid, HydrationBar[playerid]);
	HydrationBar[playerid] = INVALID_PLAYER_BAR_ID;
	DestroyPlayerProgressBar(playerid, SpeedoRing[playerid]);
	SpeedoRing[playerid] = INVALID_PLAYER_BAR_ID;
	DestroyPlayerProgressBar(playerid, BoostGauge[playerid]);
	BoostGauge[playerid] = INVALID_PLAYER_BAR_ID;
	return 1;
}
